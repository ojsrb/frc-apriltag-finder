{
    "method": "bayes",
    "metric": {"goal": "maximize", "name": "valid_tags"},
    "early_terminate": {
        "type": "hyperband",
        "min_iter": 3,
        "eta": 2,
        "s": 2
    },
    "parameters": {
        "channels": {"max":  128, "min":  32},
        "layers": {"max":  8, "min":  3},

        "batch_size": {"max": 64, "min": 16},
        "lr": {"max": 1e-2, "min": 1e-4},
        "weight_decay": {"max": 1e-3, "min": 1e-5},
        "epochs": {"max":  20, "min":  5},

        "lr_step": {"max":  25, "min":  2},
        "lr_gamma": {"max":  0.5, "min":  0.1},

        "beta1": {"value": 0.9},
        "beta2": {"value":  0.999},

        "quad_decimate": {"max":  2.0, "min":  1.0},
        "quad_sigma": {"max":  0.2, "min":  0.0},
        "min_cluster_pixels": {"max":  10, "min":  1},
        "max_nmaxima": {"max":  30, "min":  10},
        "min_white_black_diff": {"max":  50, "min":  5}
    }
}